{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'Sin dependencias: la web es estática'",
  "buildCommand": "echo 'Sin compilación: la lista verificada la publica GitHub Actions cada día'",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/data/:path*",
      "destination": "https://mwatanabedotto-cell.github.io/8bits-channel/data/:path*"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=1800" }]
    }
  ]
}
