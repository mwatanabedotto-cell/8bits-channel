{
  "name": "8bits-channel",
  "version": "1.0.0",
  "private": true,
  "description": "Visor IPTV de los canales de iptv-org ordenados por país y enfoque, solo con streams accesibles",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:quick": "node scripts/build.mjs --no-check",
    "serve": "python3 -m http.server 8080 --directory public",
    "test": "CHECK_TIMEOUT=1500 node --test test/*.test.mjs"
  }
}
